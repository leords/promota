# Banco de dados
POSTGRES_USER=promota
POSTGRES_PASSWORD=promota
POSTGRES_DB=promota

# Connection string usada pela API em runtime — role sem BYPASSRLS (ver data/schema.sql).
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5433/promota

# Connection string usada só para migrations/seed — superuser, dono das tabelas.
MIGRATE_DATABASE_URL=postgres://promota:promota@localhost:5433/promota

API_PORT=3334
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=8h

# Armazenamento de fotos (Fase 2 — provedor a definir, ver docs/DECISIONS.md)
PHOTO_STORAGE_PROVIDER=
PHOTO_STORAGE_BUCKET=

# E-mail transacional — Resend (ver docs/DECISIONS.md). Sem RESEND_API_KEY, o
# serviço só loga no console em vez de enviar (ver apps/api/src/services/email.ts) —
# não é obrigatório preencher para rodar o resto do sistema em dev.
RESEND_API_KEY=
EMAIL_FROM=Promota <onboarding@resend.dev>
